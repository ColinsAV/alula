{
  "name": "@colinsavenue/alula",
  "version": "0.1.1",
  "description": "Une DX façon Flutter pour React : composants à contrat explicite, état encapsulé, et (bientôt) state management partagé.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./next/server": {
      "types": "./dist/next/server.d.ts",
      "import": "./dist/next/server.js",
      "require": "./dist/next/server.cjs"
    },
    "./next/client": {
      "types": "./dist/next/client.d.ts",
      "import": "./dist/next/client.js",
      "require": "./dist/next/client.cjs"
    }
  },
  "bin": {
    "alula": "./dist/next/cli.mjs"
  },
  "files": [
    "dist",
    "template",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "cd src/examples && node ../next/cli.mjs dev",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "dev:native": "cd src/examples && node ../next/cli.mjs dev --native"
  },
  "peerDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@expo/vector-icons": ">=15.0.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@react-native-community/slider": ">=5.0.0",
    "@react-navigation/native": ">=7.0.0",
    "@react-navigation/native-stack": ">=7.0.0",
    "expo": ">=58.0.0",
    "expo-document-picker": ">=58.0.0",
    "expo-image": ">=58.0.0",
    "expo-linear-gradient": ">=58.0.0",
    "next": ">=15.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.88.0",
    "react-native-paper": ">=5.15.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-screens": ">=4.0.0"
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@expo/vector-icons": "^15.0.2",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@react-native-community/slider": "^5.2.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "expo": "~58.0.20",
    "expo-document-picker": "~58.0.5",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.0",
    "jsdom": "^25.0.1",
    "next": "^15.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "keywords": [
    "react",
    "widgets",
    "flutter",
    "state-management",
    "components"
  ],
  "license": "MIT",
  "peerDependenciesMeta": {
    "@expo/vector-icons": {
      "optional": true
    },
    "@react-native-community/slider": {
      "optional": true
    },
    "@react-navigation/native": {
      "optional": true
    },
    "@react-navigation/native-stack": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "expo-document-picker": {
      "optional": true
    },
    "expo-image": {
      "optional": true
    },
    "expo-linear-gradient": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-paper": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-screens": {
      "optional": true
    }
  }
}
